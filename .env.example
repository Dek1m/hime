# Redis
REDIS_URL=redis://localhost:6379/0

# SQLite
SQLITE_PATH=data/proxies.db

# Scraper
MAX_CONCURRENT=100
REQUEST_TIMEOUT=15
SEARCH_DOMAIN=google.com
LANGUAGE=ru
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:128.0) Gecko/20100101 Firefox/128.0

# Proxy
CHECK_INTERVAL=60
RATE_LIMIT_RPM=12
HEALTH_CHECK_TIMEOUT=5
MAX_FAILURES=3

# Cache
CACHE_TTL=3600
CACHE_PREFIX=hime

# Logging
LOG_LEVEL=INFO
